# Helper function to find scores in text
def parse_score(text, pattern):
    """Uses regex to find a score in text. Returns float or 'N/A'."""
    match = re.search(pattern, text)
    if match:
        try:
            return float(match.group(1))
        except:
            return "Error"
    return "N/A"

