# Helper to safely format a score for printing
def format_score(score):
    """Formats a score to 4 decimal places if it's a float, otherwise returns the string."""
    if isinstance(score, float) or (isinstance(score, str) and score.replace('.', '', 1).isdigit()):
        return f"{float(score):.4f}"
    return str(score)

